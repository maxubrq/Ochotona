{
  "name": "@ochotona/compiler",
  "version": "0.1.0",
  "description": "Giữa ocho.yaml và model: đọc, ghi YAML tất định, suy luồng và họ topology, phiên import, tự kiểm vòng tròn",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup -c ../../rollup.config.base.js",
    "test": "vitest run --exclude test/perf.test.ts",
    "test:perf": "vitest run test/perf.test.ts",
    "test:coverage": "vitest run --coverage --coverage.include=src/**",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.check.json",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:mutation": "stryker run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ochotona/model": "workspace:*",
    "@ochotona/spec": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@types/js-yaml": "^4",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "js-yaml": "^4",
    "vitest": "^5.0.3"
  }
}
