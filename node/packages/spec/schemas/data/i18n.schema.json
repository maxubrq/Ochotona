{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ochotona:data:i18n",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^rule\\.[A-Z]{1,4}[0-9]{1,2}\\.(title|what|dataSafety|next|mechanism|action)$": {
      "type": "string",
      "minLength": 1
    },
    "^rule\\.[A-Z]{1,4}[0-9]{1,2}\\.(what|dataSafety|next|mechanism)\\.[a-z][a-z0-9_]*$": {
      "type": "string",
      "minLength": 1
    },
    "^diag\\.[A-Z]{1,4}[0-9]{1,2}\\.(message|next)$": {
      "type": "string",
      "minLength": 1
    },
    "^reason\\.[a-z_]+$": {
      "type": "string",
      "minLength": 1
    },
    "^reason\\.[a-z_]+\\.unlock$": {
      "type": "string"
    },
    "^exclusion\\.EX[0-9]+$": {
      "type": "string",
      "minLength": 1
    },
    "^import\\.consequence\\.(binding|direct|family|fanout)$": {
      "type": "string",
      "minLength": 1
    }
  }
}
