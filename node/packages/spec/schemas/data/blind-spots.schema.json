{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ochotona:data:blind-spots",
  "type": "object",
  "additionalProperties": false,
  "required": ["blindSpots"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "blindSpots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "caughtBy", "rules"],
        "properties": {
          "id": { "type": "string", "pattern": "^LE[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "caughtBy": {
            "enum": ["doctor", "client", "lint", "decide", "none"]
          },
          "rules": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "plannedIn": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
        }
      }
    }
  }
}
