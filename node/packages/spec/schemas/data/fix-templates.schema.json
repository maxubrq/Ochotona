{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ochotona:data:fix-templates",
  "type": "object",
  "additionalProperties": false,
  "required": ["templates"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tool", "command", "params", "assumption"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(\\.[a-z]+)+$" },
          "tool": { "const": "rabbitmqadmin" },
          "command": { "type": "string", "minLength": 1 },
          "params": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
          },
          "assumption": { "type": "string" }
        }
      }
    }
  }
}
