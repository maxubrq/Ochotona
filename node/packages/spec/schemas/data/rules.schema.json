{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ochotona:data:rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "family",
          "tier",
          "appliesTo",
          "severities",
          "dependsOnTolerance",
          "targetVersionOnly",
          "sources",
          "fix",
          "specRef",
          "lessonRefs",
          "params",
          "status",
          "since"
        ],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]{1,4}[0-9]{1,2}$" },
          "family": { "enum": ["T", "R", "C", "N", "Q", "L", "VT", "DX", "F"] },
          "tier": { "type": "integer", "minimum": 1, "maximum": 5 },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "severities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["S1", "S2", "S3", "S4", "S5"] }
          },
          "dependsOnTolerance": { "type": "boolean" },
          "targetVersionOnly": { "type": "boolean" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["http.list", "http.stats", "prometheus"] }
          },
          "fix": {
            "enum": [
              "policy",
              "argument_migration",
              "client_change",
              "config",
              "none"
            ]
          },
          "specRef": {
            "type": "string",
            "pattern": "^spec/[0-9]+\\.[0-9]+#[A-Z-]+[0-9]+$"
          },
          "lessonRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^lesson#[0-9]+(\\.[a-z0-9-]+)?$"
            }
          },
          "params": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
            "additionalProperties": {
              "enum": ["string", "number", "instant", "list"]
            }
          },
          "status": { "enum": ["active", "experimental", "deprecated"] },
          "since": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "deprecatedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "if": { "properties": { "status": { "const": "deprecated" } } },
        "then": { "required": ["deprecatedAt"] }
      }
    }
  }
}
