{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ochotona:data:glossary",
  "type": "object",
  "additionalProperties": false,
  "required": ["terms"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "forbidden"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "forbidden": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
