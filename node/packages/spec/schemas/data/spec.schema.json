{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ochotona:data:spec",
  "type": "object",
  "additionalProperties": false,
  "$defs": { "text": { "type": "string", "minLength": 1 } },
  "required": [
    "spec",
    "contracts",
    "broker",
    "severities",
    "results",
    "tolerances",
    "objectKinds",
    "reasonKinds",
    "exitCodes",
    "docs"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "spec": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding", "report", "snapshot", "ochoYaml"],
      "properties": {
        "finding": { "type": "integer", "minimum": 1 },
        "report": { "type": "integer", "minimum": 1 },
        "snapshot": { "type": "integer", "minimum": 1 },
        "ochoYaml": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "broker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minSupported", "tested"],
      "properties": {
        "minSupported": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "tested": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "severities": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "tier", "label"],
        "properties": {
          "level": { "type": "string", "pattern": "^S[1-5]$" },
          "tier": { "type": "integer", "minimum": 1, "maximum": 5 },
          "label": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "vi"],
            "properties": {
              "en": { "type": "string", "minLength": 1 },
              "vi": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "results": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z_]+$" }
    },
    "tolerances": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z_]+$" }
    },
    "objectKinds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z_]+$" }
    },
    "reasonKinds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z_]+$" }
    },
    "exitCodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2", "3", "4", "5", "130"],
      "properties": {
        "0": { "$ref": "#/$defs/text" },
        "1": { "$ref": "#/$defs/text" },
        "2": { "$ref": "#/$defs/text" },
        "3": { "$ref": "#/$defs/text" },
        "4": { "$ref": "#/$defs/text" },
        "5": { "$ref": "#/$defs/text" },
        "130": { "$ref": "#/$defs/text" }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "lesson"],
      "properties": {
        "$comment": { "type": "string" },
        "spec": { "type": "string", "pattern": "\\{anchor\\}" },
        "lesson": { "type": "string", "pattern": "\\{anchor\\}" }
      }
    }
  }
}
