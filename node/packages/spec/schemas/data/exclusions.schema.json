{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ochotona:data:exclusions",
  "type": "object",
  "additionalProperties": false,
  "required": ["exclusions"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "match", "scopes"],
        "properties": {
          "id": { "type": "string", "pattern": "^EX[0-9]+$" },
          "kind": { "enum": ["exchange", "queue", "binding", "consumer"] },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "nameEquals": { "type": "string" },
              "namePrefix": { "type": "string", "minLength": 1 },
              "exclusive": { "const": true },
              "sourceEquals": { "type": "string" },
              "queueEquals": { "type": "string" },
              "hasOutgoingBindings": { "const": false }
            }
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["topology", "rules"] }
          },
          "rulesOutcome": { "enum": ["skip", "not_applicable_with_note"] }
        },
        "if": {
          "properties": {
            "scopes": { "type": "array", "contains": { "const": "rules" } }
          }
        },
        "then": { "required": ["rulesOutcome"] },
        "else": { "not": { "required": ["rulesOutcome"] } }
      }
    }
  }
}
