{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "$comment": "Mutation testing cho tám luật S1 (định nghĩa hoàn thành: điểm ≥ 85%). Runner command, vì @stryker-mutator/vitest-runner 10 không bật được mutant trong worker của vitest 5.",
  "testRunner": "command",
  "mutate": [
    "src/catalog/T1.ts",
    "src/catalog/T2.ts",
    "src/catalog/T3.ts",
    "src/catalog/T4.ts",
    "src/catalog/T5.ts",
    "src/catalog/T9.ts",
    "src/catalog/R1.ts",
    "src/catalog/C1.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 85
  },
  "reporters": ["clear-text", "progress", "json"],
  "tempDirName": ".stryker-tmp",
  "concurrency": 6,
  "commandRunner": {
    "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.stryker.config.ts"
  },
  "coverageAnalysis": "off"
}
