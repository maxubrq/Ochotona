                     --apply-to 'queues' --priority '0' --definition
                     '{"dead-letter-exchange":"ocho.parking","dead-letter-strategy":"at-least-once","delivery-limit":10,"max-length":100000,"overflow":"reject-publish"}'
                     ocho explain T4
